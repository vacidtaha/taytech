generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  nameTr    String
  nameEn    String
  image     String?
  sortOrder Int        @default(0)
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  categoryId    Int
  category      Category         @relation(fields: [categoryId], references: [id])
  nameTr        String
  nameEn        String
  descriptionTr String           @default("")
  descriptionEn String           @default("")
  sortOrder     Int              @default(0)
  isActive      Boolean          @default(true)
  image         String?
  applicationImage String?
  specTableData    String?
  images        ProductImage[]
  variants      ProductVariant[]
  documents     ProductDocument[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductDocument {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameTr    String
  nameEn    String
  url       String
  urlEn     String?
  type      String   @default("datasheet")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  slug        String
  label       String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  titleTr       String
  titleEn       String
  descriptionTr String     @default("")
  descriptionEn String     @default("")
  image         String?

  // JSON arrays stored as text
  featuresTr    String     @default("[]")
  featuresEn    String     @default("[]")
  techSpecsTr   String     @default("[]")
  techSpecsEn   String     @default("[]")

  // Optional structured data (JSON)
  technicalData String?
  mediaTabs     String?

  documents Document[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([productId, slug])
}

model Document {
  id        Int            @id @default(autoincrement())
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  nameTr    String
  nameEn    String
  url       String
  type      String         @default("datasheet")
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
}
